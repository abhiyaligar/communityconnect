# ========================================
# CommunityConnect Backend Configuration
# ========================================

# Application Configuration
APP_NAME=CommunityConnect
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development # development, staging, production

# FastAPI Server Settings
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL)
# Render automatically injects DATABASE_URL in production. 
# Use 'postgresql+asyncpg://...' for async API clients and 'postgresql+psycopg2://...' for Alembic migrations.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/communityconnect
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/communityconnect

# Redis Configuration (Optional Rate Limiting / Caching)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (JSON List of strings)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# SMS OTP Provider Config (MSG91 or Twilio)
SMS_PROVIDER=mock # mock, twilio, msg91 (use mock for local testing without credentials)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# File Storage Configuration
# local uses server disk (Render persistent disk recommended), gcs uses Google Cloud Storage
STORAGE_PROVIDER=local 
UPLOAD_DIR=./uploads
GCS_BUCKET_NAME=
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_JSON=
