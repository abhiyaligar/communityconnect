# ========================================
# CommunityConnect Backend Configuration
# ========================================

# Application
APP_NAME=CommunityConnect
APP_VERSION=1.0.0
DEBUG=True

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/communityconnect
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/communityconnect

# JWT Auth
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Server
HOST=0.0.0.0
PORT=8000
